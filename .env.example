PROCUREMENT_API_URL=https://prod-api-admin.fushangyunfu.com/admin-api/erp/offline-order/page
PROCUREMENT_TOKEN=Bearer <replace-with-procurement-token>
INVOICE_OCR_APPCODE=<replace-with-aliyun-market-appcode>
INVOICE_OCR_API_URL=https://gjbsb.market.alicloudapi.com/ocrservice/advanced
MONGODB_URI=mongodb://127.0.0.1:27017/crowfunding?directConnection=true&replicaSet=rs0
# 如需连公司测试服务器，改用：mongodb://<user>:<password>@<host>:27018/?authSource=admin&replicaSet=rs0&directConnection=true
MONGODB_DB=crowfunding
MONGODB_COLLECTION_PREFIX=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_OBJECT_PREFIX=crowfunding

# IAM 后端接口和浏览器登录页可部署在不同地址。
IAM_BASE_URL=http://system.localhost:8080
IAM_WEB_URL=http://system.localhost:5173
IAM_CLIENT_ID=crowdfunding
IAM_CLIENT_SECRET=<replace-with-server-side-client-secret>
IAM_REDIRECT_URI=http://127.0.0.1:5174/oauth/callback
APP_ALLOWED_ORIGIN=http://127.0.0.1:5174
