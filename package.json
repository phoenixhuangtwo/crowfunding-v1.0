{
  "name": "internal-subscription-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env.local --import tsx server/server.ts",
    "build": "npm run typecheck:server && vue-tsc -b && vite build",
    "typecheck:server": "tsc --noEmit --allowImportingTsExtensions --module nodenext --moduleResolution nodenext --target es2022 --types node --skipLibCheck server/server.ts",
    "preview": "vite preview",
    "local": "bash scripts/local-processes.sh",
    "test": "npm run test:unit && npm run test:integration:share && npm run test:integration:permissions",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:integration:share": "npm run test:integration:iam-boundary && npm run test:integration:share-concurrency",
    "test:integration:share-concurrency": "node --env-file-if-exists=.env.local --import tsx tests/share-concurrency.integration.ts",
    "test:integration:agreements": "node --env-file-if-exists=.env.local --import tsx tests/agreements.integration.ts",
    "test:integration:iam-boundary": "node --env-file-if-exists=.env.local --import tsx tests/iam-boundary.integration.ts",
    "test:integration:backstop": "node --env-file-if-exists=.env.local --import tsx tests/company-backstop.integration.ts",
    "test:smoke": "npm run test:integration:share",
    "test:smoke:legacy": "node tests/smoke.mjs",
    "storage:preflight": "node --env-file-if-exists=.env.local --import tsx scripts/storage-preflight.ts",
    "storage:reconcile": "node --env-file-if-exists=.env.local --import tsx scripts/storage-reconcile.ts",
    "test:integration:permissions": "node --env-file-if-exists=.env.local --import tsx tests/role-permission-regressions.integration.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "busboy": "^1.6.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "element-plus": "^2.8.8",
    "json-bigint": "^1.0.0",
    "mongodb": "^7.6.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vue-tsc": "^2.1.10"
  }
}
